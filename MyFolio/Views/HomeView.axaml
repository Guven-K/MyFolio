<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyFolio.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1400" d:DesignHeight="800"
             x:Class="MyFolio.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Background="#F1F5F9">

    <Design.DataContext>
        <vm:HomeViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="60,*">

        <!-- Navigation Bar -->
        <Border Grid.Row="0" Background="White" BoxShadow="0 2 10 0 #18000000">
            <Grid Margin="32,0" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="MyFolio" FontWeight="Bold" FontSize="22"
                           VerticalAlignment="Center" Foreground="#1E293B"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="4" VerticalAlignment="Center">
                    <Button Content="Home" Padding="14,6" Background="Transparent"/>
                    <Button Content="Profile" Padding="14,6" Background="Transparent"/>
                    <Button Content="Settings" Padding="14,6" Background="Transparent"/>
                </StackPanel>
                <Border Grid.Column="2" Width="38" Height="38" CornerRadius="19"
                        ClipToBounds="True" VerticalAlignment="Center"
                        BoxShadow="0 2 6 0 #20000000">
                    <Image Source="{Binding ProfilePicture}" Stretch="UniformToFill"/>
                </Border>
            </Grid>
        </Border>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="980" HorizontalAlignment="Center"
                        Margin="24,36,24,48" Spacing="20">

                <!-- Hero Card -->
                <Border Background="White" CornerRadius="16" Padding="44,38"
                        BoxShadow="0 4 28 0 #12000000">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <Border Width="108" Height="108" CornerRadius="54" ClipToBounds="True"
                                HorizontalAlignment="Center" BoxShadow="0 4 16 0 #35000000">
                            <Image Source="{Binding ProfilePicture}" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="Your Name" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" Foreground="#1E293B"/>
                        <TextBlock Text="Software Developer  ·  UI/UX Designer  ·  Open Source Contributor"
                                   FontSize="14" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Spacing="10" Margin="0,10,0,0">
                            <Button Content="View Projects"
                                    Background="#2563EB" Foreground="White"
                                    Padding="20,10" CornerRadius="8"/>
                            <Button Content="Contact Me"
                                    Background="#F1F5F9" Foreground="#334155"
                                    Padding="20,10" CornerRadius="8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- About Me + Skills Row -->
                <Grid ColumnDefinitions="*,20,*">

                    <!-- About Me Card -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="26"
                            BoxShadow="0 4 28 0 #12000000">
                        <StackPanel Spacing="12">
                            <TextBlock Text="About Me" FontSize="17" FontWeight="SemiBold"
                                       Foreground="#1E293B"/>
                            <Rectangle Height="3" Width="36" Fill="#2563EB" HorizontalAlignment="Left"/>
                            <TextBlock FontSize="13" Foreground="#475569" TextWrapping="Wrap" LineHeight="22"
                                       Text="I'm a passionate developer who loves crafting beautiful, functional applications. I specialize in modern UI/UX design and cross-platform development with .NET and Avalonia UI."/>
                        </StackPanel>
                    </Border>

                    <!-- Skills Card -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="26"
                            BoxShadow="0 4 28 0 #12000000">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Skills" FontSize="17" FontWeight="SemiBold"
                                       Foreground="#1E293B"/>
                            <Rectangle Height="3" Width="36" Fill="#2563EB" HorizontalAlignment="Left"/>
                            <WrapPanel Orientation="Horizontal">
                                <Border Background="#EFF6FF" CornerRadius="6" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="C#" Foreground="#2563EB" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="6" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text=".NET" Foreground="#2563EB" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="6" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="Avalonia UI" Foreground="#2563EB" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="6" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="MVVM" Foreground="#2563EB" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="6" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="WPF" Foreground="#2563EB" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="6" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="Git" Foreground="#2563EB" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="6" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="SQL" Foreground="#2563EB" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#EFF6FF" CornerRadius="6" Padding="10,5" Margin="0,0,8,8">
                                    <TextBlock Text="REST APIs" Foreground="#2563EB" FontSize="13" FontWeight="SemiBold"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Projects Card -->
                <Border Background="White" CornerRadius="12" Padding="26"
                        BoxShadow="0 4 28 0 #12000000">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Projects" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#1E293B"/>
                        <Rectangle Height="3" Width="36" Fill="#2563EB" HorizontalAlignment="Left"/>
                        <Grid ColumnDefinitions="*,16,*,16,*">
                            <!-- Project 1 -->
                            <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="10"
                                    Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Project One" FontWeight="SemiBold"
                                               Foreground="#1E293B" FontSize="14"/>
                                    <TextBlock Text="A cross-platform desktop application built with .NET and Avalonia UI."
                                               TextWrapping="Wrap" Foreground="#64748B" FontSize="12" LineHeight="19"/>
                                    <TextBlock Text="View ->" Foreground="#2563EB" FontSize="13"
                                               FontWeight="SemiBold" Margin="0,4,0,0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                            <!-- Project 2 -->
                            <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="10"
                                    Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Project Two" FontWeight="SemiBold"
                                               Foreground="#1E293B" FontSize="14"/>
                                    <TextBlock Text="A RESTful API service with SQL database integration and authentication."
                                               TextWrapping="Wrap" Foreground="#64748B" FontSize="12" LineHeight="19"/>
                                    <TextBlock Text="View ->" Foreground="#2563EB" FontSize="13"
                                               FontWeight="SemiBold" Margin="0,4,0,0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                            <!-- Project 3 -->
                            <Border Grid.Column="4" Background="#F8FAFC" CornerRadius="10"
                                    Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Project Three" FontWeight="SemiBold"
                                               Foreground="#1E293B" FontSize="14"/>
                                    <TextBlock Text="An open-source UI component library for modern desktop applications."
                                               TextWrapping="Wrap" Foreground="#64748B" FontSize="12" LineHeight="19"/>
                                    <TextBlock Text="View ->" Foreground="#2563EB" FontSize="13"
                                               FontWeight="SemiBold" Margin="0,4,0,0" Cursor="Hand"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Contact Card -->
                <Border Background="White" CornerRadius="12" Padding="26"
                        BoxShadow="0 4 28 0 #12000000">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Get In Touch" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#1E293B"/>
                        <Rectangle Height="3" Width="36" Fill="#2563EB" HorizontalAlignment="Left"/>
                        <TextBlock FontSize="13" Foreground="#475569" TextWrapping="Wrap"
                                   Text="Feel free to reach out for collaborations, opportunities, or just a friendly chat. I'm always open to new ideas and projects!"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <Border Background="#EFF6FF" CornerRadius="8" Padding="14,8">
                                <TextBlock Text="your.email@example.com" Foreground="#2563EB"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#EFF6FF" CornerRadius="8" Padding="14,8">
                                <TextBlock Text="github.com/yourusername" Foreground="#2563EB"
                                           FontSize="13" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
