 <Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:MyFolio.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:ia="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
		xmlns:core="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
		mc:Ignorable="d"
		d:DesignWidth="800" d:DesignHeight="500"
		x:Class="MyFolio.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		RenderOptions.TextRenderingMode="Antialias"
		Icon="/Assets/avalonia-logo.ico"
		Title="MyFolio"
		TransparencyLevelHint="AcrylicBlur"
		WindowStartupLocation="CenterScreen"
		ExtendClientAreaChromeHints="SystemChrome"
		ExtendClientAreaToDecorationsHint="False"
		Width="1400"
		Height="800">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Grid>
		<!-- Setup phase: shown until the user navigates away -->
		<Grid ShowGridLines="True"
			  IsVisible="{Binding IsSetupVisible}"
			  RowDefinitions="20*,50*,25*"
			  ColumnDefinitions="25*,25*,25*">

			<StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Spacing="5"
						VerticalAlignment="Center" HorizontalAlignment="Center">
				<Button Content="Home" Command="{Binding NavigateHomeCommand}"/>
				<Button Content="Profile" />
				<Button Content="Settings"/>
			</StackPanel>

			<StackPanel Grid.Column="2" Grid.Row="0" VerticalAlignment="Center">
				<TextBlock Text="MyFolio" FontWeight="Bold" FontFamily="Sans-serif"
						   FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" />
			</StackPanel>

			<!-- Row 1: Center content (profile picture above greeting) -->
			<StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Spacing="16">

				<!-- Profile Picture Container -->
				<Grid Width="140" Height="140"
					  HorizontalAlignment="Center"
					  VerticalAlignment="Center"
					  Cursor="Hand">

					<Border CornerRadius="90" Background="White" BoxShadow="0 3 50 0 DarkGray" ClipToBounds="True">
						<Image Source="{Binding ProfilePicture}" Stretch="UniformToFill" />
					</Border>

					<Border Background="#80000000" CornerRadius="50"
							IsVisible="{Binding IsHovering}">
						<TextBlock Text="Change Profile Pic" Foreground="White" FontWeight="Bold"
								   HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>

					<Button Command="{Binding ChangeProfilePicture}"
							Background="Transparent"
							BorderThickness="0"
							Opacity="0"/>
				</Grid>

				<!-- Greeting Text -->
				<TextBlock Text="{Binding Greeting}"
						   FontSize="24"
						   FontWeight="SemiBold"
						   HorizontalAlignment="Center"
						   TextAlignment="Center"
						   Margin="10"/>
			</StackPanel>

			<!-- Continue Button -->
			<Border Grid.Row="2" Grid.Column="1" CornerRadius="6" Background="Gainsboro"
					Padding="10" BorderThickness="0.6" BorderBrush="Black" Margin="20"
					HorizontalAlignment="Center" VerticalAlignment="Center">
				<Button Command="{Binding ContinueCommand}" Content="Continue" FontWeight="Bold" Background="Gainsboro"/>
			</Border>
		</Grid>

		<!-- Navigation phase: ViewLocator resolves CurrentPage to the matching View -->
		<ContentControl Content="{Binding CurrentPage}"
						IsVisible="{Binding IsNavigationVisible}"/>
	</Grid>
</Window>
